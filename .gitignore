# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!examples/scripts/.env.example

# claude code per-user settings + runtime
.claude/settings.local.json
.claude/scheduled_tasks.lock

# per-publish runtime artifacts — auto-generated by publish-dataset-cli.mjs,
# would leak the publisher's absolute CSV path if committed
*.inferred-schema.json

# cross-skill handoff: written after every successful publish so downstream
# skills (proof-plan generation, /v1/zkquery verify) auto-pick up the active
# dataset. Contains the publisher's wallet hex — never commit.
.last-publish.json
examples/data/.last-publish.json
examples/data/proof-plans/*/

# untrack the dataset-specific CSV + schema seeded during the latest
# debugging session — keep the canonical demo datasets only.
examples/data/sui_stakers.csv
examples/data/sui_stakers.inferred-schema.json

# foundry build artifacts (per-project)
examples/contracts/sxt-onchain-query/dependencies/
examples/contracts/sxt-onchain-query/cache/
examples/contracts/sxt-onchain-query/out/
examples/contracts/sxt-onchain-query/.deploy-state.json
examples/contracts/sxt-onchain-query/.deploy-state.json.*
examples/contracts/sxt-onchain-query/.last-rendered.json

# slither audit artifacts — large + ephemeral, generated per-run
examples/contracts/sxt-onchain-query/slither-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# windows
Thumbs.db

# npm pack output
*.tgz
