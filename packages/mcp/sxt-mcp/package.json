{
  "name": "@biffbuster/sxt-mcp",
  "version": "0.4.0",
  "description": "MCP server exposing the Space and Time publish-and-prove pipeline as typed MCP tools. Publish a CSV to a chain-secured table, run Proof of SQL, audit Solidity, deploy contracts. Mainnet double-gated, testnet defaults.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/biffbuster/sxt-tools.git",
    "directory": "packages/mcp/sxt-mcp"
  },
  "bin": {
    "sxt-mcp": "./dist/index.js",
    "sxt-mcp-http": "./dist/http.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "SAFETY.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/bundle-docs.mjs",
    "prepublishOnly": "npm run build && npm test",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/day1-smoke.mjs && node scripts/day2-http-smoke.mjs",
    "build:worker": "node scripts/bundle-docs.mjs && node scripts/build-worker-verifier.mjs",
    "dev:worker": "npm run build:worker && wrangler dev",
    "check:worker": "npm run build:worker && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:worker": "npm run build:worker && wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@polkadot/api": "^11.0.0",
    "@polkadot/util": "^12.0.0",
    "@polkadot/util-crypto": "^12.0.0",
    "apache-arrow": "^17.0.0",
    "csv-parse": "^5.5.0",
    "ethers": "^6.13.0",
    "express": "^5.3.0",
    "sxt-proof-of-sql-sdk": "0.54.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "space-and-time",
    "sxt",
    "proof-of-sql",
    "claude"
  ]
}
