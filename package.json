{
  "name": "sxt-tools",
  "version": "0.2.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm --prefix examples/scripts install --silent && npm --prefix packages/mcp/sxt-mcp install --silent && npm --prefix packages/mcp/sxt-mcp run build --silent",
    "preflight": "node examples/scripts/preflight.mjs --read-only",
    "preflight:full": "node examples/scripts/preflight.mjs",
    "demo": "node examples/scripts/preflight.mjs --read-only && node examples/scripts/demo-rehearsal.mjs",
    "demo:full": "node examples/scripts/preflight.mjs && node examples/scripts/demo-rehearsal.mjs",
    "demo:parity": "node examples/scripts/mcp-parity-test.mjs",
    "demo:fullpipeline": "node examples/scripts/preflight.mjs && node examples/scripts/demo-fullpipeline.mjs",
    "demo:fullpipeline:rehearse": "node examples/scripts/demo-fullpipeline.mjs --skip-onchain"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.12"
  }
}
